type ValidateBetResult = 
 variant {
   Err: text;
   Ok: nat;
 };
type UpdateOrderReceipt = 
 variant {
   Err: text;
   Ok: ImmutableOrder;
 };
type TransferResult = 
 variant {
   Err: FailedTransfer;
   Ok: SuccessfulTransfer;
 };
type TransferFromError = 
 variant {
   BadBurn: record {min_burn_amount: nat;};
   BadFee: record {expected_fee: nat;};
   CreatedInFuture: record {ledger_time: nat64;};
   Duplicate: record {duplicate_of: nat;};
   GenericError: record {
                   error_code: nat;
                   message: text;
                 };
   InsufficientAllowance: record {allowance: nat;};
   InsufficientFunds: record {balance: nat;};
   TemporarilyUnavailable;
   TooOld;
 };
type TransferError = 
 variant {
   BadBurn: record {min_burn_amount: nat;};
   BadFee: record {expected_fee: nat;};
   CreatedInFuture: record {ledger_time: nat64;};
   Duplicate: record {duplicate_of: nat;};
   GenericError: record {
                   error_code: nat;
                   message: text;
                 };
   InsufficientFunds: record {balance: nat;};
   TemporarilyUnavailable;
   TooOld;
 };
type Time = int;
type SuccessfulTransfer = 
 record {
   amount: nat;
   user: principal;
 };
type Result__1 = 
 variant {
   Err: text;
   Ok: text;
 };
type Result = 
 variant {
   Err: TransferError;
   Ok: nat;
 };
type Premium = nat;
type PlaceOrderResult = 
 variant {
   Err: TransferFromError;
   Ok: ImmutableOrder;
 };
type PlaceOrder = 
 record {
   contracts: nat;
   odds: nat;
   side: OrderSide;
 };
type OrderStatus = 
 variant {
   cancelled;
   filled;
   open;
 };
type OrderSide = 
 variant {
   buy;
   sell;
 };
type OrderResult = 
 variant {
   Err;
   loss;
   win;
 };
type OrderID = text;
type OrderBooksResponse = vec MarketOrderBookResponse;
type OrderBookState = 
 variant {
   Cancelled;
   Finishing;
   LongPositionWon;
   NonePositionWon;
   Ongoing;
   Paused;
   ShortPositionWon;
 };
type OrderBookResponse = 
 record {
   buy: vec OrderBookPricePoint;
   sell: vec OrderBookPricePoint;
 };
type OrderBookPricePoint = 
 record {
   contracts: nat;
   odds: nat;
 };
type MatchedOrderSide = 
 record {
   isFreeBet: bool;
   orderId: OrderID;
   "principal": principal;
 };
type MatchedOrder = 
 record {
   buy: MatchedOrderSide;
   buyPremium: nat;
   contracts: nat;
   id: OrderID;
   matchedAt: Time;
   sell: MatchedOrderSide;
 };
type MarketTradedAmount = 
 record {
   amount: nat;
   marketId: MarketID;
 };
type MarketProcessingResult = 
 record {
   marketId: MarketID;
   processingResult: Result__1;
 };
type MarketOrderBookResponse = 
 record {
   marketId: MarketID;
   orderBook: OrderBookResponse;
   state: OrderBookState;
 };
type MarketInfo = 
 record {
   betType: text;
   id: nat;
   name: text;
   result: opt bool;
 };
type MarketID = nat;
type MarketBalance = 
 record {
   balances: ImmutableBalances;
   marketId: MarketID;
   marketName: text;
 };
type InitEventDetails = 
 record {
   eventType: text;
   id: EventID;
   leagueId: nat;
   markets: vec MarketInfo;
   sport: text;
 };
type InitArgs = 
 record {
   eventArgs: InitEventDetails;
   initControllers: vec principal;
 };
type ImmutableOrder = 
 record {
   createdAt: Time;
   currentContracts: nat;
   eventId: EventID;
   id: OrderID;
   initialContracts: nat;
   isFreeBet: bool;
   marketId: MarketID;
   premium: Premium;
   processedByUserbook: bool;
   side: OrderSide;
   stake: nat;
   status: OrderStatus;
   updatedAt: Time;
   user: principal;
 };
type ImmutableBalances = 
 record {
   commissions: nat;
   matched: nat;
   open: nat;
 };
type GraphDataPoint = 
 record {
   contracts: nat;
   odds: nat;
   time: Time;
 };
type GraphData = 
 record {
   betType: BetType;
   data: vec GraphDataPoint;
   marketId: MarketID;
   marketName: text;
 };
type FinalisedMatchedBet = 
 record {
   canisterId: principal;
   commission: nat;
   contracts: nat;
   createdAt: Time;
   eventId: EventID;
   isFreeBet: bool;
   marketId: MarketID;
   marketName: text;
   matchedAt: Time;
   nftHolder: bool;
   odds: nat;
   outcome: OrderResult;
   processedByUserbook: bool;
   side: OrderSide;
   stake: nat;
   user: principal;
 };
type FinalisedCreatedBet = 
 record {
   canisterId: principal;
   commission: nat;
   createdAt: Time;
   eventId: EventID;
   initialContracts: nat;
   isFreeBet: bool;
   marketId: MarketID;
   marketName: text;
   nftHolder: bool;
   odds: nat;
   orderId: OrderID;
   outcome: OrderResult;
   processedByUserbook: bool;
   side: OrderSide;
   stake: nat;
   status: OrderStatus;
   unmatchedContracts: nat;
   updatedAt: Time;
   user: principal;
 };
type FailedTransfer = 
 record {
   error: TransferError;
   intendedAmount: nat;
   user: principal;
 };
type EventStatsData = 
 record {
   betTypeTradedAmounts: vec BetTypeTradedAmount;
   graphData: vec GraphData;
   lastUpdateErrorMessage: opt text;
   lastUpdatedAt: Time;
   marketTradedAmounts: vec MarketTradedAmount;
   orderBooks: OrderBooksResponse;
   totalTradedAmount: nat;
 };
type EventID = nat;
type EventEndData = 
 record {
   canisterId: principal;
   createdBets: vec FinalisedCreatedBet;
   endTime: Time;
   eventId: EventID;
   marketAccounting: vec MarketBalance;
   marketProcessingResults: vec MarketProcessingResult;
   matchedBets: vec FinalisedMatchedBet;
   totalCommissions: nat;
   totalMatched: nat;
   totalOpen: nat;
   transferResults: vec TransferResult;
 };
type Event = 
 service {
   cancelOrder: (OrderID) -> (CancelOrderReceipt);
   endEvent: (InitEventDetails) -> (EventEndData);
   getAdmins: () -> (vec principal);
   getAllCreatedOrders: () -> (vec ImmutableOrder) query;
   getAllFullyUpdatedOrders: () -> (vec ImmutableOrder) query;
   getAllMatchedOrders: () -> (vec MatchedOrder);
   getBetTypeTradedAmount: (BetType) -> (nat) query;
   getCaller: () -> (principal);
   getCommission: () -> (nat) query;
   getDetailsForOrderPlacedEvent: (text) ->
    (opt DetailsForOrderPlacedEvent) query;
   getEventDetails: () -> (InitEventDetails) query;
   getEventStatsData: (opt nat64) -> (opt EventStatsData) query;
   getFullyUpdatedOrders: (nat, nat) -> (vec FinalisedCreatedBet);
   getGraphData: () -> (vec GraphData) query;
   getMarketMakerPrincipals: () -> (vec principal);
   getMarketNames: () -> (vec text) query;
   getMarketTradedAmount: (MarketID) -> (nat) query;
   getMatchedOrder: (text) -> (opt MatchedOrder) query;
   getOrder: (text) -> (opt ImmutableOrder) query;
   getOrderBook: (MarketID) -> (opt OrderBookResponse) query;
   getOrderBooks: () -> (OrderBooksResponse) query;
   getOrderBooksStates: () -> (vec OrderBookState) query;
   getOrdersForUser: (principal) -> (vec ImmutableOrder);
   getTotalTradedAmount: () -> (nat) query;
   getTransactionFee: () -> (nat) query;
   getUserOrders: () -> (vec ImmutableOrder) query;
   getUserOrdersByMarket: (MarketID) -> (vec ImmutableOrder) query;
   init: (InitArgs) -> (InitEventDetails);
   isMarketMakerPrincipal: (principal) -> (bool);
   panicEvent: () -> (EventEndData);
   panicMarket: (nat) -> (vec TransferResult);
   placeFreeBetOrder: (MarketID, PlaceOrder, principal) -> (PlaceOrderResult);
   placeOrder: (MarketID, PlaceOrder) -> (PlaceOrderResult);
   removeAdmin: (principal) -> ();
   removeDetailsForOrderPlacedEvent: (text) -> ();
   setAdmin: (principal) -> ();
   updateOrder: (OrderID, nat) -> (UpdateOrderReceipt);
   updateOrderBookState: (MarketID, OrderBookState) -> (bool);
   updateState: (OrderBookState) -> ();
   validateFreeBetOrder: (MarketID, PlaceOrder, principal) ->
    (ValidateBetResult) query;
   validateOrder: (MarketID, PlaceOrder) -> (ValidateBetResult) query;
   withdrawCommissions: () -> (Result);
 };
type EnvVariant = 
 variant {
   Development: text;
   IC: text;
   Local: text;
   Staging: text;
 };
type DetailsForOrderPlacedEvent = 
 record {
   order: ImmutableOrder;
   topBuyOrder: opt OrderBookPricePoint;
   topSellOrder: opt OrderBookPricePoint;
 };
type CancelOrderReceipt = 
 variant {
   Err: text;
   Ok: nat;
 };
type BetTypeTradedAmount = 
 record {
   amount: nat;
   betType: BetType;
 };
type BetType = text;
service : (EnvVariant) -> Event
